+/// Whether the parser sits on the start of a keyed field: `[expression] =` or `name =`.
+#[cfg(feature = "hexm")]
+fn at_keyed_field(state: &ParserState) -> bool {
+    match state.current() {
+        Ok(token) if token.is_symbol(Symbol::LeftBracket) => true,
+        Ok(token) if token.token_kind() == TokenKind::Identifier => {
+            matches!(state.peek(), Ok(peek_token) if peek_token.is_symbol(Symbol::Equal))
+        }
+        _ => false,
+    }
+}
+
+/// Parses the arguments of a parenthesised call in HexM Lua, after the `(`.
+/// Arguments may be keyed like table fields: `dict(a = 1, [k] = v)`, optionally
+/// mixed with positional ones. A call without any keyed argument parses exactly
+/// like standard Lua, into a [`FunctionArgs::Parentheses`](ast::FunctionArgs::Parentheses).
+#[cfg(feature = "hexm")]
+fn parse_hexm_arguments(
+    state: &mut ParserState,
+    left_parenthesis: TokenReference,
+) -> ParserResult<ast::FunctionArgs> {
+    let mut fields: Punctuated<ast::Field> = Punctuated::new();
+    let mut keyed = false;
+
+    loop {
+        let field = if at_keyed_field(state) {
+            keyed = true;
+
+            if state.current().unwrap().is_symbol(Symbol::LeftBracket) {
+                let left_bracket = state.consume().unwrap();
+
+                match expect_expression_key(state, left_bracket) {
+                    Ok(field) => field,
+                    Err(()) => break,
+                }
+            } else {
+                let key = state.consume().unwrap();
+                let equal_token = state.consume().unwrap();
+
+                match parse_expression(state) {
+                    ParserResult::Value(expression) => ast::Field::NameKey {
+                        key,
+                        equal: equal_token,
+                        value: Box::new(expression),
+                    },
+
+                    ParserResult::NotFound => {
+                        state.token_error(equal_token, "expected an expression after `=`");
+                        break;
+                    }
+
+                    ParserResult::LexerMoved => break,
+                }
+            }
+        } else {
+            match parse_expression(state) {
+                ParserResult::Value(expression) => ast::Field::NoKey(expression),
+
+                // Unlike standard Lua, HexM accepts a trailing comma in a call,
+                // such as `dict(a = 1, b = 2,)` (its keyed calls mirror Python
+                // kwargs, which allow it). `call()` reaches here too and is fine.
+                ParserResult::NotFound => break,
+
+                ParserResult::LexerMoved => break,
+            }
+        };
+
+        match state.current() {
+            Ok(token) if token.is_symbol(Symbol::Comma) => {
+                fields.push(Pair::Punctuated(field, state.consume().unwrap()));
+            }
+
+            _ => {
+                fields.push(Pair::End(field));
+                break;
+            }
+        }
+    }
+
+    // Drop any trailing comma so the node still prints validly (the formatter
+    // does not emit one for these calls regardless).
+    if let Some(Pair::Punctuated(..)) = fields.last() {
+        let last_field = fields.pop().unwrap().into_value();
+        fields.push(Pair::End(last_field));
+    }
+
+    let right_parenthesis = match state.require_with_reference_token(
+        Symbol::RightParen,
+        "expected `)` to close function call",
+        &left_parenthesis,
+    ) {
+        Some(token) => token,
+
+        None => TokenReference::basic_symbol(")"),
+    };
+
+    let parentheses = ContainedSpan::new(left_parenthesis, right_parenthesis);
+
+    if keyed {
+        return ParserResult::Value(ast::FunctionArgs::Fields {
+            parentheses,
+            fields,
+        });
+    }
+
+    // No keyed arguments: this is a standard call
+    let arguments = fields
+        .into_pairs()
+        .map(|pair| {
+            pair.map(|field| match field {
+                ast::Field::NoKey(expression) => expression,
+                _ => unreachable!("keyed field in a call without keyed arguments"),
+            })
+        })
+        .collect();
+
+    ParserResult::Value(ast::FunctionArgs::Parentheses {
+        parentheses,
+        arguments,
+    })
 }
 
